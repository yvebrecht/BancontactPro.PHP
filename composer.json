{
    "name": "dewall88/bancontactpro",
    "description": "Unofficial PHP client for the Bancontact Pro payment, refund and reconciliation APIs.",
    "type": "library",
    "keywords": ["bancontact", "bancontact pro", "payment", "refund", "reconciliation", "payconiq"],
    "homepage": "https://github.com/yvebrecht/BancontactPro.PHP",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "BancontactPro\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "BancontactPro\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": true }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": ["@lint", "@analyse", "@test"]
    }
}
